<Project>
  <!--
    Single source of truth for the product version across every project in the solution.
    Pre-1.0: we are at 0.7.x - the release that moved the schema to EF Core and made SQLite the
    default backend. This sets AssemblyVersion / FileVersion / InformationalVersion, so
    UpdateService.CurrentVersion (which reads Assembly.GetName().Version) reports 0.7.3 instead of
    the .NET default 1.0.0.0. A tagged release overrides this on the command line
    (dotnet publish -p:Version=1.2.3), so the released binaries carry the tag's version.
  -->
  <PropertyGroup>
    <Version>0.7.3</Version>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Direct pin of a transitive dependency, so the floor is declared in one place instead of being
      whatever MimeKit / Microsoft.Data.SqlClient happened to require. System.Security.Cryptography.Pkcs
      10.0.0 - 10.0.12 carry GHSA-846f-f764-76mx (high) and GHSA-2fmv-rv2c-59x7 (moderate); NuGet resolves
      the highest version requested, so referencing it here raises it for every project in the graph.
      Dependabot only reports such packages when a lockfile is committed (see SECURITY.md,
      'Dependency monitoring'), so this pin is the guard; drop it once the parents require
      10.0.13+ on their own.
    -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
</Project>
