<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Dispatch SMTP Relay - the service (macOS LaunchDaemon).

  installer/macos/install.sh substitutes the "__USER__" marker below with a UserName key when it was asked
  for a service account. With no UserName key launchd runs the daemon as root, which is the only way to bind
  SMTP 25/587 on macOS (there is no CAP_NET_BIND_SERVICE equivalent); with a service account the listener
  falls back to 2525 instead.
  Note: an XML comment may not contain two consecutive hyphens, so this file says "service account" where
  install.sh says the flag.
  Paths are absolute and fixed, matching /opt/dispatch + /var/db/dispatch in install.sh.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>app.dispatchrelay.dispatch</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/dispatch/current/Dispatch.Service</string>
    </array>

    <!-- The content root the service reads appsettings.json + the default ./dispatch-spool from, exactly
         like the systemd unit's WorkingDirectory=. ASPNETCORE_CONTENTROOT below pins the same path for a
         reason: the .NET host resolves the content root from the process CWD, so if launchd ever started
         this job somewhere else the service would find the shipped appsettings.json in the release
         directory (empty connection string) instead of the installed one. Silently reading a different
         file than the installer wrote is the failure mode worth double-covering. -->
    <key>WorkingDirectory</key>
    <string>/var/db/dispatch</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>DOTNET_ENVIRONMENT</key>
        <string>Production</string>
        <key>ASPNETCORE_CONTENTROOT</key>
        <string>/var/db/dispatch</string>
        <key>DISPATCH_LOG_DIR</key>
        <string>/var/log/dispatch</string>
        <!-- Persistent, private home for the at-rest encryption key. It would default to the content root
             (the same directory) as it does on Linux; it is pinned so the key location never depends on how
             content-root resolution happens to land after an updater swap. Losing this file would make
             every stored secret unreadable, so it is worth being explicit. -->
        <key>DISPATCH_KEY_DIR</key>
        <string>/var/db/dispatch</string>
    </dict>

    <!-- Octal 0077 (decimal 63), matching systemd's UMask=0077: spooled .eml/.meta files hold message
         bodies (spec §14.5) and must be created mode 600, and directories mode 700. -->
    <key>Umask</key>
    <integer>63</integer>

    <key>RunAtLoad</key>
    <true/>

    <!-- Restart on any exit, like systemd's Restart=always. launchd has no Type=notify equivalent, so
         "is it actually up" is answered by dispatch-update.sh polling /health, not by this unit.
         To stop it for real, boot the job out rather than killing the process:
         sudo launchctl bootout system/app.dispatchrelay.dispatch -->
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <!-- Crash output before the logging pipeline exists (and anything Serilog cannot write) lands here. -->
    <key>StandardOutPath</key>
    <string>/var/log/dispatch/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/dispatch/launchd.err.log</string>

    <!-- __USER__ -->
</dict>
</plist>
