<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Dispatch SMTP Relay - the upgrade watcher (macOS LaunchDaemon).

  This is dispatch-update.path + dispatch-updater.service from Linux in one file. The service stages a
  signature-verified upgrade bundle and drops /var/db/dispatch/updates/apply.request; launchd then runs
  /opt/dispatch/dispatch-update.sh as root, which does the swap, the restart and the rollback. Keeping the
  privilege in a separate job is what lets the service run as a service account and still update.

  installer/macos/install.sh substitutes __HEALTH_PORT__ with the dashboard port so the applier knows where
  to poll. It has no UserName key: it must write under /opt/dispatch, so it always runs as root.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>app.dispatchrelay.dispatch-update</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/dispatch/dispatch-update.sh</string>
    </array>

    <!-- Both the request file AND its parent directory, deliberately. WatchPaths is documented as firing
         when "the specified paths are modified", and a path that does not exist yet at bootstrap is a
         long-standing grey area on macOS; creating a file does change the directory's mtime, so watching
         the directory too closes that gap. The extra triggers this causes (status.json writes, staging) are
         free: dispatch-update.sh exits immediately when there is no apply.request, and holds a lock so two
         watchers can never race the same upgrade. -->
    <key>WatchPaths</key>
    <array>
        <string>/var/db/dispatch/updates/apply.request</string>
        <string>/var/db/dispatch/updates</string>
    </array>

    <!-- On-demand only: never at load, never kept alive. -->
    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>DISPATCH_HEALTH_PORT</key>
        <string>__HEALTH_PORT__</string>
    </dict>

    <!-- The dashboard's Updates page reads state from status.json; this is for when an update fails so badly
         the script never got to write it. -->
    <key>StandardOutPath</key>
    <string>/var/log/dispatch/updater.out.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/dispatch/updater.err.log</string>
</dict>
</plist>
